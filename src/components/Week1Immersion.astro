---
interface Props {
  /** Only week 1's route passes true; every other week renders the slot untouched. */
  active?: boolean;
  /** Full text of the in-world system notice. Always rendered in full — the
   *  typewriter effect (if it runs at all) is a visual replay on top of it. */
  notice?: string;
}

const { active = false, notice = "" } = Astro.props;
---

{
  active ? (
    <div class="week1-immersion">
      <div class="civop-notice-panel">
        <p class="civop-notice" id="civop-notice">
          {notice}
        </p>
        <button type="button" class="civop-skip" id="civop-skip" hidden>
          Skip animation
        </button>
      </div>
      <slot />
    </div>
  ) : (
    <slot />
  )
}

<style>
  .week1-immersion {
    margin-block: var(--at-spacing-lg) 0;
  }

  .civop-notice-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--at-spacing-md);
    padding-bottom: var(--at-spacing-md);
    margin-bottom: var(--at-spacing-lg);
    border-bottom: 1px solid var(--at-border);
  }

  .civop-notice {
    margin: 0;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    letter-spacing: 0.02em;
    color: var(--at-text-secondary);
  }

  .civop-skip {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    color: var(--at-text);
    background: var(--at-bg-alt);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .civop-skip:hover {
    background: var(--at-bg-elevated);
  }
</style>

{
  active && (
    <script is:inline data-astro-rerun>
      (function () {
        var notice = document.getElementById("civop-notice");
        var skipButton = document.getElementById("civop-skip");
        if (!notice) return;
        var fullText = notice.textContent || "";
        var seenKey = "week1-notice-seen";
        var alreadySeen = sessionStorage.getItem(seenKey) === "1";
        var reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (alreadySeen || reducedMotion || !fullText) {
          sessionStorage.setItem(seenKey, "1");
          return;
        }
        sessionStorage.setItem(seenKey, "1");

        // Lock the box height before clearing the text so revealing it back
        // character-by-character never shifts surrounding layout.
        notice.style.minHeight = notice.getBoundingClientRect().height + "px";
        // A static label means assistive tech announces the full notice once,
        // rather than reading each intermediate, partial string as it types.
        notice.setAttribute("aria-label", fullText);
        notice.textContent = "";
        if (skipButton) skipButton.hidden = false;

        var index = 0;
        var charsPerTick = 2;
        var timer = setInterval(function () {
          index += charsPerTick;
          notice.textContent = fullText.slice(0, index);
          if (index >= fullText.length) finish();
        }, 20);
        function finish() {
          clearInterval(timer);
          notice.textContent = fullText;
          if (skipButton) skipButton.hidden = true;
        }
        if (skipButton) skipButton.addEventListener("click", finish);
      })();
    </script>
  )
}

{
  active && (
    <script is:inline data-astro-rerun>
      (function () {
        // Forces the whole page — header, nav, footer, background, not just
        // this panel — into the theme's dark palette while Week 1 is open, by
        // setting the same `data-theme` attribute the site's own toggle uses
        // (tokens.css resolves every `--at-*` colour from it via `light-dark()`,
        // and that resolution is inherited, so setting it on <html> covers
        // everything). It never touches `localStorage["at-theme"]` — that key
        // is the user's real saved preference, and only the footer toggle's
        // own handler is allowed to write it.
        var root = document.documentElement;
        var TOGGLE_SELECTOR = ".at-footer-theme-toggle";
        var forced = false;

        // Same resolution the site's own head script uses. Reading it here
        // directly — rather than trusting `root.dataset.theme` at this exact
        // moment — means restoring the preference never depends on this
        // script running after that one during a client-side transition.
        function resolvePreference() {
          return (
            localStorage.getItem("at-theme") ||
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          );
        }

        function release() {
          if (!forced) return;
          root.dataset.theme = resolvePreference();
          forced = false;
          document.removeEventListener("astro:before-swap", release);
          document.removeEventListener("click", interceptToggle, { capture: true });
        }

        // The footer toggle must stay visible and functional (it's the site's
        // only theme control), but its default handler assumes `data-theme`
        // reflects the saved preference and would write the inverse of our
        // forced "dark" to localStorage. Intercept the click in the capture
        // phase — before that handler runs — and treat it as "step out of the
        // Week 1 override for this visit" instead, without writing anything.
        // Named (not anonymous) so `release` can remove exactly this listener
        // instead of it accumulating one extra registration per visit.
        function interceptToggle(event) {
          if (!forced) return;
          var target = event.target;
          var toggle = target && target.closest ? target.closest(TOGGLE_SELECTOR) : null;
          if (!toggle) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          release();
        }

        root.dataset.theme = "dark";
        forced = true;
        document.addEventListener("astro:before-swap", release, { once: true });
        document.addEventListener("click", interceptToggle, { capture: true });
      })();
    </script>
  )
}
